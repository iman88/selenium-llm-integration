{
  "mappings": [
    {
      "name": "OpenAI heals region 1: bad id, good text",
      "request": {
        "method": "POST",
        "url": "/v1/chat/completions",
        "bodyPatterns": [
          { "matchesJsonPath": { "expression": "$.model", "equalTo": "gpt-4o" } },
          { "matchesJsonPath": { "expression": "$.messages[1].content", "contains": "//*[@id='query-btnn' and contains(text(), 'Button')]" } },
          { "matchesJsonPath": { "expression": "$.messages[1].content", "contains": "id=\"query-btn\"" } }
        ]
      },
      "response": {
        "status": 200,
        "jsonBody": { "choices": [ { "index": 0, "message": { "role": "assistant", "content": "//*[@id='query-btn' and contains(text(), 'Button')]" } } ] }
      }
    },
